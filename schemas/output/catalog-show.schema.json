{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "catalog show"
        },
        "op_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,30}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "resources": {
                  "type": "object",
                  "properties": {
                    "memory_mb": {
                      "type": "number",
                      "minimum": 0
                    },
                    "disk_mb": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "memory_mb",
                    "disk_mb"
                  ],
                  "additionalProperties": false
                },
                "requires": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,30}$"
                  }
                },
                "main_service": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,30}$"
                },
                "routes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]*$"
                      },
                      "service": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{1,30}$"
                      },
                      "port": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535
                      },
                      "host": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "service",
                      "port",
                      "host"
                    ],
                    "additionalProperties": false
                  }
                },
                "volumes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_-]*$"
                      },
                      "backup": {
                        "type": "string",
                        "enum": [
                          "files",
                          "skip"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "backup"
                    ],
                    "additionalProperties": false
                  }
                },
                "stop_during_backup": {
                  "default": false,
                  "type": "boolean"
                },
                "env": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]*$"
                      },
                      "generate": {
                        "type": "string",
                        "pattern": "^(password|token):[1-9][0-9]{0,3}$"
                      },
                      "value": {
                        "type": "string"
                      },
                      "secret": {
                        "default": false,
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name",
                      "secret"
                    ],
                    "additionalProperties": false
                  }
                },
                "config_files": {
                  "default": [],
                  "type": "array",
