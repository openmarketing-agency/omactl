                    "type": "object",
                    "properties": {
                      "template": {
                        "type": "string",
                        "pattern": "^files\\/"
                      },
                      "volume": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "template",
                      "volume",
                      "path"
                    ],
                    "additionalProperties": false
                  }
                },
                "provides": {
                  "default": [],
