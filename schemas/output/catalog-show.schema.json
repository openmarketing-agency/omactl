                            },
                            "timeout": {
                              "default": 120,
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "one_off": {
                              "default": false,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "service",
                            "script",
                            "timeout",
                            "one_off"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "post_restore": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "service": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]{1,30}$"
                            },
                            "script": {
                              "type": "string",
                              "pattern": "^hooks\\/[a-zA-Z0-9._/-]+\\.sh$"
                            },
                            "timeout": {
                              "default": 120,
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "one_off": {
                              "default": false,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "service",
                            "script",
                            "timeout",
                            "one_off"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "migrate": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "service": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]{1,30}$"
                            },
                            "script": {
                              "type": "string",
                              "pattern": "^hooks\\/[a-zA-Z0-9._/-]+\\.sh$"
                            },
                            "timeout": {
                              "default": 120,
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "one_off": {
                              "default": false,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "service",
                            "script",
                            "timeout",
                            "one_off"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "on_link": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "service": {
                              "type": "string",
                              "pattern": "^[a-z][a-z0-9-]{1,30}$"
                            },
                            "script": {
                              "type": "string",
                              "pattern": "^hooks\\/[a-zA-Z0-9._/-]+\\.sh$"
                            },
                            "timeout": {
                              "default": 120,
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            "one_off": {
                              "default": false,
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "service",
                            "script",
                            "timeout",
                            "one_off"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "setup",
                    "verify"
                  ],
                  "additionalProperties": false
                },
                "ready_timeout": {
                  "default": 180,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "name",
                "version",
                "description",
                "resources",
                "requires",
                "main_service",
                "routes",
                "volumes",
                "stop_during_backup",
                "env",
                "config_files",
                "provides",
                "consumes",
                "hooks",
                "ready_timeout"
              ],
              "additionalProperties": false
