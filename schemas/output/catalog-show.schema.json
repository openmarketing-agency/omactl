                    "type": "object",
                    "properties": {
                      "capability": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "env_prefix": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]*$"
                      },
                      "default_provider": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9-]{1,30}$"
                      }
                    },
                    "required": [
                      "capability",
                      "required",
                      "env_prefix"
                    ],
                    "additionalProperties": false
                  }
                },
                "hooks": {
                  "type": "object",
                  "properties": {
                    "setup": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{1,30}$"
                        },
                        "script": {
                          "type": "string",
                          "pattern": "^hooks\\/[a-zA-Z0-9._/-]+\\.sh$"
                        },
                        "timeout": {
                          "default": 120,
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "one_off": {
                          "default": false,
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "service",
                        "script",
                        "timeout",
                        "one_off"
                      ],
                      "additionalProperties": false
                    },
                    "verify": {
                      "type": "object",
                      "properties": {
                        "service": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9-]{1,30}$"
                        },
                        "script": {
                          "type": "string",
