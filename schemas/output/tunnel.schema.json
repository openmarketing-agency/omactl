{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "const": "tunnel"
        },
        "op_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "ok": {
          "type": "boolean",
          "const": true
        },
        "data": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "app": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{1,30}$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "reused": {
                  "type": "boolean"
                }
              },
              "required": [
                "app",
                "url",
                "reused"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string"
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "destructive": {
                  "type": "boolean"
                },
                "confirmation": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "steps": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "command",
                "targets",
                "destructive",
                "confirmation",
                "steps"
              ],
              "additionalProperties": false
            }
          ]
        },
        "error": {
          "type": "null"
        }
      },
      "required": [
        "command",
        "op_id",
        "warnings",
        "ok",
        "data",
        "error"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
